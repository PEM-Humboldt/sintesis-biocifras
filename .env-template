# Archivo .env para configuracion de variables de entorno

# ===============================
# Configuracion de la base de datos
# ===============================
# Credenciales y parámetros de conexion a la base de datos PostgreSQL
DATABASE_USER=<DATABASE_USER>         # Usuario de la base de datos
DATABASE_PASS=<DATABASE_PASS>         # Password del usuario
DATABASE_HOST=<DATABASE_HOST>         # Host o IP del servidor de base de datos
DATABASE_PORT=5432                    # Puerto de conexion (por defecto 5432)
DATABASE_NAME=<DATABASE_NAME>         # Nombre de la base de datos

# ===============================
# Configuracion de logging
# ===============================
# LOG_FILE_PATH define la ubicación donde se guardan los logs generados por la aplicacion.
# Puedes especificar una ruta absoluta (por ejemplo: /home/usuario/logs/app.log)
# o una ruta relativa al directorio del proyecto (por ejemplo: logs/app.log).
LOG_FILE_PATH=/home/loggin.log

# ===============================
# Rutas de archivos de datos GBIF
# ===============================
# carpeta para descargar los archivos zip (descargas automaticas de GBIF)
DIR_DOWNLOAD_ZIP=<RUTA_DE_LA_CARPETA_DE_DESCARGA>


# Rutas absolutas a los archivos TSV descargados de GBIF
SIMPLE_FILE=<RUTA_AL_ARCHIVO_SIMPLE.CSV>
OCURRENCE_FILE=<RUTA_AL_ARCHIVO_OCURRENCE.TXT>
SQL_FILE=<RUTA_AL_ARCHIVO_SQL.CSV>

# ================================
# Fuentes externas 
# ================================
EXTDATADIR=<RUTA A LA CARPETA DE DATOS EXTERNOS>
URL_MGN_DEPT_MUNI="https://geoportal.dane.gov.co/descargas/mgn_2025/MGN2025_MPIO_GRAFICO.zip"
FILE_SPAT_NARINO_MARITIMO=<RUTA AL ARCHIVO ESPACIAL DE LA REGIÓN MARITIMA DE NARIÑO>
FILE_SPAT_REGIONES_MARITIMAS=<RUTA AL ARCHIVO ESPACIAL DE LAS REGIONES MARITIMAS DE COLOMBIA>
FILE_SPAT_NUCLEOS_DFYB=<RUTA AL ARCHIVO ESPACIAL DE LOS NUCLEOS DE DFYB>
FILE_SPAT_REGION_AMAZONIA=<RUTA AL ARCHIVO ESPACIAL DE LA REGION AMAZONIA>
FILE_SPAT_RESERVAS=<RUTA AL ARCHIVO ESPACIAL DE LAS RESERVAS>
FILE_SPAT_RESGUARDOS=<RUTA AL ARCHIVO ESPACIAL DE LOS RESGUARDOS>
FILE_DEPT_VALIDATION=<RUTA AL ARCHIVO DE VALIDACIÓN DE DEPARTAMENTOS>
FILE_MUNI_VALIDATION=<RUTA AL ARCHIVO DE VALIDACIÓN DE MUNICIPIOS>
FILE_MASTER_GEOGRAPHY=<RUTA AL ARCHIVO MAESTRO DE GEOGRAFÍA>
FILE_TAXONOMIC_LIST=<RUTA AL ARCHIVO DE LISTA TAXONOMICA DE COLOMBIA>
FILE_TAXONOMIC_INVASIVE_EXOTIC=<RUTA AL ARCHIVO DE LISTA DE ESPECIES EXOTICAS Y INVASORAS>
FILE_TAXONOMIC_AVES_MIGRATORIAS=<RUTA AL ARCHIVO DE LISTA DE ESPECIES DE AVES MIGRATORIAS>
FILE_TAXONOMIC_CITES=<RUTA AL ARCHIVO DE LISTA DE ESPECIES CLASIFICADAS CITES>
FILE_TAXONOMIC_IUCN=<RUTA AL ARCHIVO DE LISTA DE ESPECIES CLASIFICADAS IUCN>
FILE_TAXONOMIC_MADS=<RUTA AL ARCHIVO DE LISTA DE ESPECIES AMENAZADAS DE COLOMBIA>
FILE_TAXONOMIC_WORMS=<RUTA AL ARCHIVO DE LISTA DE ESPECIES VALIDADAS POR WORMS>
FILE_TAXONOMIC_GROUPS=<RUTA AL ARCHIVO DE LISTA DE ESPECIES VALIDADAS POR WORMS>
FILE_STATS_DATA_RELEVANT=<RUTA AL ARCHIVO DE DATOS RELEVANTES EN TSV>
FILE_STATS_GROUP=<RUTA AL ARCHIVO DE GRUPOS BIOLOGICOS EN TSV>
FILE_STATS_RANKING=<RUTA AL ARCHIVO DE RANKINGS EN TSV>
FILE_STATS_SPECIES_META=<RUTA AL ARCHIVO DE ESPECIE_META EN TSV>
FILE_STATS_PATROCINADOR=<RUTA AL ARCHIVO DE PATROCINADORES EN TSV>
FILE_STATS_REGION_PATROCINADOR=<RUTA AL ARCHIVO DE REGIONES PATROCINADOR EN TSV>

# ===============================
# Configuración de User-Agent para requests
# ===============================
# USER_AGENTS define el User-Agent que se usará en las peticiones HTTP para evitar bloqueos.
USER_AGENTS="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36 Edg/135.0.0.0"

# ==============================
# GBIF credentials
# =============================
# Para utilizar la API de Gbif desde el paquete `pygbif` de python, se necesitan credenciales.
GBIF_USER="your_gbif_username"
GBIF_PWD="your_gbif_password"
GBIF_email="your registered_email"

# ===============================
# Configuracion de rendimiento de carga
# ===============================
FLUSH_EVERY=1000000
UPDATE_BATCH_SIZE=1000000
MAINTENANCE_WORK_MEM=2GB
WORK_MEM=256MB
# Workers paralelos para CREATE INDEX / ADD PRIMARY KEY / VACUUM.
# Nativo Linux: 4. WSL/Docker con /dev/shm pequeño: 0.
MAX_PARALLEL_MAINTENANCE_WORKERS=4
# Workers paralelos para MV y para otras consultas (agregaciones, CREATE MATERIALIZED VIEW).
# Nativo Linux: 4. WSL/Docker con /dev/shm pequeño: 0.
MAX_PARALLEL_WORKERS_MV=4
# Memoria para VACUUM/ANALYZE (más baja que MAINTENANCE_WORK_MEM; evita /dev/shm lleno en WSL/Docker)
VACUUM_MAINTENANCE_WORK_MEM=512MB
# vacuum_analyze | analyze (solo estadísticas, sin barrido VACUUM)
TABLE_MAINTENANCE_MODE=vacuum_analyze
# true omite VACUUM/ANALYZE tras cada paso masivo
SKIP_TABLE_MAINTENANCE=false
RUN_VACUUM_FULL=false
